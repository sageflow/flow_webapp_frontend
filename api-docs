    "paths": {
        "/staff/complaints/{complaintId}/status": {
            "put": {
                "tags": [
                    "Complaints - Staff"
                ],
                "summary": "Update complaint status",
                "description": "Updates the status of a complaint. Status transitions must follow the workflow:\n- SUBMITTED → UNDER_REVIEW (via assign)\n- UNDER_REVIEW → INVESTIGATING\n- INVESTIGATING → RESOLVED or DISMISSED\n",
                "operationId": "updateStatus",
                "parameters": [
                    {
                        "name": "complaintId",
                        "in": "path",
                        "description": "Complaint ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "New status",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "SUBMITTED",
                                "UNDER_REVIEW",
                                "INVESTIGATING",
                                "RESOLVED",
                                "DISMISSED",
                                "ESCALATED"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status updated successfully",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ComplaintResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid status transition",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ComplaintResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication required",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ComplaintResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Not authorized to update this complaint",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ComplaintResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Complaint not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ComplaintResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
